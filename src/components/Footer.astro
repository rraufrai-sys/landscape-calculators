---
import { tools } from "../config/tools";
import { site } from "../config/site";

const pages = [
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
  { href: "/disclaimer/", label: "Disclaimer" },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__name">{site.legalName}</p>
      <p>{site.tagline}</p>
    </div>
    <nav aria-label="Calculators">
      <ul>
        {tools.map((tool) => <li><a href={tool.href}>{tool.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="About this site">
      <ul>
        {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
      </ul>
    </nav>
    <p class="site-footer__note">
      Estimates stay in this browser. They are not a design or a supplier ticket. The public email
      is on the Contact page.
    </p>
  </div>
</footer>
