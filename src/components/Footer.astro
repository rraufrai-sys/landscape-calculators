---
import { tools } from "../config/tools";
import { site } from "../config/site";

const pages = [
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
  { href: "/disclaimer/", label: "Disclaimer" },
];

const iconPaths = {
  Pinterest:
    "M12 2a10 10 0 0 0-3.6 19.3c-.1-.8-.2-2 0-2.9.2-.8 1.3-5.5 1.3-5.5s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.6 0 .9-.6 2.3-.9 3.6-.2 1.1.5 2 1.6 2 1.9 0 3.2-2.4 3.2-5.3 0-2.2-1.5-3.8-4.2-3.8-3.1 0-4.9 2.3-4.9 4.8 0 .9.3 1.9.7 2.4.1.1.1.2.1.3l-.3 1.1c-.1.2-.2.3-.4.2-1.4-.6-2.1-2.3-2.1-4.1 0-3 2.6-6.6 7.5-6.6 4 0 6.6 2.9 6.6 6 0 4.1-2.3 7.2-5.7 7.2-1.1 0-2.2-.6-2.6-1.4l-.7 2.7c-.3 1-.9 2.1-1.4 2.8A10 10 0 1 0 12 2z",
  YouTube:
    "M23 12.2s0-3.2-.4-4.6c-.2-.9-.9-1.6-1.8-1.8C19.2 5.4 12 5.4 12 5.4s-7.2 0-8.8.4c-.9.2-1.6.9-1.8 1.8C1 9 1 12.2 1 12.2s0 3.2.4 4.6c.2.9.9 1.6 1.8 1.8 1.6.4 8.8.4 8.8.4s7.2 0 8.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.4.4-4.6.4-4.6zM9.8 15.5V8.9l6.2 3.3-6.2 3.3z",
  Facebook:
    "M14.2 21v-7.2h2.4l.4-2.8h-2.8V9.3c0-.8.2-1.4 1.4-1.4H17V5.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 4v2.2H8.4v2.8h2.5V21h3.3z",
  X: "M14.7 10.3 22.4 2h-1.8l-6.7 7.2L8.4 2H2.2l8.1 11.1L2.2 22h1.8l7.1-7.6L15.4 22h6.2l-6.9-11.7zm-2.5 2.7-.8-1.1L4.7 3.3h2.8l5.2 7 .8 1.1 6.8 9.2h-2.8l-5.5-7.6z",
} as const;
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__name">{site.legalName}</p>
      <p>{site.tagline}</p>
      <nav class="site-footer__social" aria-label="Social profiles">
        <ul>
          {
            site.social.map((profile) => (
              <li>
                <a
                  href={profile.href}
                  target="_blank"
                  rel="noopener me"
                  aria-label={`${site.legalName} on ${profile.name}`}
                >
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d={iconPaths[profile.name]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <nav aria-label="Calculators">
      <ul>
        {tools.map((tool) => <li><a href={tool.href}>{tool.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="About this site">
      <ul>
        {pages.map((page) => <li><a href={page.href}>{page.label}</a></li>)}
      </ul>
    </nav>
    <p class="site-footer__note">
      Estimates stay in this browser. They are not a design or a supplier ticket. The public email
      is on the Contact page.
    </p>
  </div>
</footer>
