---
import { assetUrl, pageUrl, site } from "../config/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  omitCanonical?: boolean;
  jsonLd?: unknown;
}

const { title, description, noindex = false, omitCanonical = false, jsonLd } = Astro.props;
const canonical = pageUrl(Astro.url.pathname);
const image = assetUrl("/og.png");
const json = jsonLd === undefined ? "" : JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
{!omitCanonical && <link rel="canonical" href={canonical} />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#14261c" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:locale" content={site.locale} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!omitCanonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Yardwork calculators for gravel, mulch, topsoil, and sod" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{json !== "" && <script type="application/ld+json" set:html={json} />}
