---
import { tools } from "../config/tools";

interface Props {
  current: string;
}

const { current } = Astro.props;
const others = tools.filter((tool) => tool.href !== current);
---

<section id="related" aria-labelledby="related-heading">
  <h2 id="related-heading">Which calculator matches the material?</h2>
  <ul class="related">
    {
      others.map((tool) => (
        <li>
          <a href={tool.href}>{tool.name}</a>: {tool.detail}
        </li>
      ))
    }
  </ul>
</section>
