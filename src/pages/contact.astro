---
import Breadcrumb from "../components/Breadcrumb.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { contactJsonLd } from "../lib/seo";

const title = "Contact Abdul Rauf | Landscaping Calculators";
const description =
  "Email Abdul Rauf at r.rauf.rai@gmail.com about these landscaping calculators. There is no message form. Your own email program sends the note.";
---

<BaseLayout title={title} description={description} jsonLd={contactJsonLd(description)}>
  <header class="page-intro">
    <Breadcrumb current="Contact" />
    <h1>Contact</h1>
  </header>
  <article class="prose">
    <h2>How do I reach Abdul Rauf?</h2>
    <p>
      Email {site.publisherName} at
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
      There is no message form on this page. Your own email program sends the note.
      This page does not promise how soon you will get a reply.
    </p>
    <p>
      There is no company, street address, or phone number to list. The <a href="/about/">About</a> page says the same thing.
    </p>
    <h2>What should I send if a calculator result looks wrong?</h2>
    <p>A useful note names the calculator, the numbers you typed, and the result you expected.</p>
    <ul>
      <li>Which calculator you used: gravel, mulch, topsoil, or sod.</li>
      <li>The numbers you typed, and the units, such as feet, inches, cubic yards, or pounds.</li>
      <li>The result you saw, and the result you expected.</li>
      <li>The browser you used.</li>
    </ul>
    <p>Do not include passwords, payment details, or other private information in that note.</p>
  </article>
</BaseLayout>
