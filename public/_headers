# Security headers for the static site. Advertising scripts are not loaded, so script-src stays on this origin.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Hashed build assets can be cached for a long time. HTML keeps the platform default of revalidation.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the preview hostnames out of the index. The public canonical host is siteUrl in src/config/site.ts.
https://:worker.:account.workers.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex
